---
interface Props {
  title: string;
  company: string;
  description: string;
  date: string;
  index: number;
}

const {
  title,
  company,
  description,
  date,
  index,
} = Astro.props;

const formattedIndex = String(index).padStart(2, "0");
---

<article
  class="experience-item group grid gap-6 border-b border-white/10 py-9 first:border-t sm:py-10 md:grid-cols-[160px_1fr] md:gap-10 md:py-12 lg:grid-cols-[180px_1fr] lg:gap-14"
>
  <div>
    <div class="flex items-center gap-3 md:flex-col md:items-start md:gap-2">
      <span
        class="font-mono text-xs tracking-[0.18em] text-[#B8F36B]"
        aria-hidden="true"
      >
        {formattedIndex}
      </span>

      <time class="text-sm leading-6 text-[#B8B9B1]">
        {date}
      </time>
    </div>
  </div>

  <div
    class="grid gap-5 lg:grid-cols-[minmax(220px,0.85fr)_minmax(300px,1.15fr)] lg:gap-14 xl:gap-20"
  >
    <div>
      <h3
        class="text-2xl font-medium tracking-[-0.03em] text-[#F5F3EB] transition-colors duration-300 group-hover:text-[#B8F36B] sm:text-3xl"
      >
        {title}
      </h3>

      <p
        class="mt-2 text-xs font-medium uppercase tracking-[0.14em] text-[#777970] sm:text-sm"
      >
        {company}
      </p>
    </div>

    <p
      class="max-w-xl text-[0.95rem] leading-7 text-[#B8B9B1] sm:text-base"
    >
      {description}
    </p>
  </div>
</article>

<style>
  .experience-item {
    position: relative;
  }

  .experience-item::before {
    content: "";

    position: absolute;
    left: 0;
    bottom: -1px;

    width: 0;
    height: 1px;

    background: #b8f36b;

    transition: width 500ms ease;
  }

  @media (hover: hover) {
    .experience-item:hover::before {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-item::before {
      transition: none;
    }
  }
</style>